# ── TransitFlow core API ───────────────────────────────────────────────
# Port the HTTP server listens on (default 4000)
PORT=4000

# Required for POST /api/scan (AI route extraction).
# Create one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=paste_your_key_here

# Optional: Gemini model to use (default gemini-2.5-flash).
# Set to any vision-capable model your key can access.
GEMINI_MODEL=gemini-2.5-flash

# Optional: Redis for durable storage (Vercel KV, Upstash, or local redis).
# Leave empty to use in-memory storage (alerts persist until restart).
REDIS_URL=

# Optional: comma-separated list of allowed CORS origins.
# Default allows localhost:3000 and all *.vercel.app / *.netlify.app origins.
CORS_ORIGINS=

# Optional: path to the route dataset (default <repo>/data/routes.json)
DATA_PATH=

# Alert lifetime in minutes (default 30). Older alerts leave the radar.
ALERT_TTL_MINUTES=30
