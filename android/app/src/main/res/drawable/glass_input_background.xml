<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="1dp"
        android:right="1dp"
        android:top="3dp">
        <shape>
            <corners android:radius="100dp" />
            <solid android:color="@color/glass_shadow_soft" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#25FFFFFF" />
            <corners android:radius="100dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/glass_highlight_top" />
        </shape>
    </item>
</layer-list>