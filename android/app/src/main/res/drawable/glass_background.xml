<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Soft Bottom Drop Shadow -->
    <item
        android:bottom="0dp"
        android:left="2dp"
        android:right="2dp"
        android:top="6dp">
        <shape>
            <corners android:radius="100dp" />
            <solid android:color="@color/glass_shadow_soft" />
        </shape>
    </item>

    <!-- 2. Frosted Glass Fill -->
    <item>
        <shape>
            <solid android:color="@color/glass_fill" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- 3. Specular Highlight (Bright Top Border) -->
    <item>
        <shape>
            <corners android:radius="100dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/glass_highlight_top" />
        </shape>
    </item>

    <!-- 4. Subtle Bottom Contour Shadow -->
    <item
        android:top="2dp">
        <shape>
            <corners android:radius="100dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke_bottom" />
        </shape>
    </item>
</layer-list>