<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background_gradient"
    tools:context=".LoginActivity">

    <LinearLayout
        android:id="@+id/login_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/glass_background"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="RAIL-GATHI"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Multi-Factor Intelligence Platform"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_passenger_mode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/glass_button_primary"
            android:text="🚆 Enter Passenger Mode"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_staff_mode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/glass_input_background"
            android:text="🚉 Station Master Control Room"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/btn_benchmark_matrix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📊 View RAIL-GATHI vs Existing Benchmark"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>